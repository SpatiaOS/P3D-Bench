# Copy to .env and fill in your keys. Values stay local; only the NAMES of
# these variables appear in configs/models.yaml (BYOK).

OPENROUTER_API_KEY=            # OpenRouter, used by the default model registry

HF_TOKEN=                      # reserved for future full-split downloads
P3DBENCH_CACHE_DIR=.cache/p3dbench

# Local upstream working tree for the full split (Fusion 360 + Text2CAD). The Hub
# never ships raw geometry; set this OR pass --source-root on the CLI.
P3DBENCH_SOURCE_ROOT=          # e.g. /path/to/cad_dataset
# API transport retry budget (total attempts per call; default 2).
# P3DBENCH_API_MAX_RETRIES=2
